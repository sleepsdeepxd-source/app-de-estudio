    <script>
        // Tailwind script
        function initializeTailwind() {
            tailwind.config = {
                content: [],
                theme: { extend: {} }
            }
        }

        // BASELINE (hombre sano 20-35 años)
        const BASELINE = {
            testosterone: 550,
            hgh: 1.2,
            igf1: 180,
            dht: 45,
            cortisol: 14
        }

        // Rangos de referencia
        const RANGES = {
            testosterone: { min: 300, low: 400, ok: 600, high: 900, max: 1100, unit: "ng/dL" },
            hgh: { min: 0.4, low: 1, ok: 3, high: 8, max: 16, unit: "ng/mL" },
            igf1: { min: 80, low: 120, ok: 200, high: 280, max: 380, unit: "ng/mL" },
            dht: { min: 20, low: 30, ok: 55, high: 85, max: 110, unit: "ng/dL" },
            cortisol: { min: 5, low: 8, ok: 18, high: 28, max: 45, unit: "mcg/dL" }
        }

        function clamp(val, min, max) {
            return Math.min(Math.max(val, min), max)
        }

        // Cálculo mejorado con todo lo que pediste
        function calcHormones(form) {
            let tMult = 1
            let hghMult = 1
            let igf1Mult = 1
            let dhtMult = 1
            let cortMult = 1

            // === TESTOSTERONA ===
            if (form.exerciseType === "compound_heavy") tMult += 0.28
            else if (form.exerciseType === "compound_moderate") tMult += 0.18
            else if (form.exerciseType === "isolation") tMult += 0.08
            else if (form.exerciseType === "hiit") tMult += 0.15
            else if (form.exerciseType === "cardio") tMult += 0.04

            if (form.intensity >= 85) tMult += 0.22
            else if (form.intensity >= 70) tMult += 0.14
            else if (form.intensity >= 55) tMult += 0.08

            if (form.rest <= 90) tMult += 0.12
            else if (form.rest <= 150) tMult += 0.06

            const volume = form.sets * form.reps
            if (volume >= 25 && volume <= 50) tMult += 0.10
            else if (volume > 50) tMult += 0.05

            if (form.timeOfDay === "morning") tMult += 0.15

            // Nutrición (tu dieta)
            let nutriMult = 1
            if (form.lentilsQuinoa) nutriMult += 0.15   // proteína completa vegetal
            if (form.sardines) nutriMult += 0.12        // omega-3 + vit D
            if (form.eggs) nutriMult += 0.18            // grasas + proteína animal barata
            tMult *= nutriMult

            // === HGH ===
            if (form.exerciseType === "hiit") hghMult += 1.9
            else if (form.exerciseType === "compound_heavy") hghMult += 1.1
            else if (form.exerciseType === "compound_moderate") hghMult += 0.8
            else if (form.exerciseType === "cardio") hghMult += 0.6

            if (form.intensity >= 85) hghMult += 0.9
            else if (form.intensity >= 70) hghMult += 0.6

            // Ayuno (efecto realista)
            if (form.fasting >= 12) hghMult += 0.9
            if (form.fasting >= 16) hghMult += 1.1
            if (form.fasting >= 24) hghMult += 1.4
            if (form.fasting >= 30) hghMult += 1.0   // pico pero ya no sube tanto

            if (form.sleep >= 8) hghMult += 1.3
            else if (form.sleep >= 7) hghMult += 0.8
            else if (form.sleep < 6) hghMult -= 0.6

            // === IGF-1 (respuesta crónica) ===
            if (form.exerciseType.includes("compound")) igf1Mult += 0.25
            if (form.intensity >= 75) igf1Mult += 0.18
            if (form.sleep >= 7.5) igf1Mult += 0.15
            igf1Mult *= nutriMult   // nutrición afecta mucho IGF-1

            // === DHT (derivado de T) ===
            dhtMult = tMult * 0.94 + 0.06

            // === CORTISOL (queremos bajarlo) ===
            if (form.duration > 60) cortMult += 0.35 * ((form.duration - 60) / 30)
            if (form.duration > 90) cortMult += 0.4
            if (form.intensity >= 90) cortMult += 0.28

            // Ayuno largo sube cortisol
            if (form.fasting >= 18) cortMult += 0.25 * ((form.fasting - 18) / 12)
            if (form.fasting > 24) cortMult += 0.35

            // Sueño malo
            if (form.sleep < 6) cortMult += 0.45
            else if (form.sleep < 7) cortMult += 0.25

            // Meditación (efecto demostrado)
            const medReduction = Math.min(0.35, form.meditation / 20 * 0.18)
